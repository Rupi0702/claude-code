# Supabase — from your project's API settings
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Stripe — publishable key (client side)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Price ID for Investor Premium (99€/month) created in the Stripe dashboard
VITE_STRIPE_PREMIUM_PRICE_ID=price_xxx

# --- Server side (Supabase Edge Function secrets, NOT exposed to the client) ---
# Set these with: supabase secrets set KEY=value
# STRIPE_SECRET_KEY=sk_test_xxx
# STRIPE_WEBHOOK_SECRET=whsec_xxx
# SUPABASE_SERVICE_ROLE_KEY=...
